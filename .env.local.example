# Supabase Configuration (server-only — never expose secret key to browser)
# Get these from Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# dave-life Supabase (/life and the blog). The public blog reads published posts with the publishable key.
NEXT_PUBLIC_LIFE_SUPABASE_URL=
NEXT_PUBLIC_LIFE_SUPABASE_PUBLISHABLE_KEY=

# Google Photos (Memories). OAuth client from Google Cloud with the Photos Picker API enabled.
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=

# Personal assistant (Grok) MCP endpoint /api/life/mcp: bearer token, 32+ chars (openssl rand -hex 32). Also set in Vercel production.
LIFE_ASSISTANT_TOKEN=
